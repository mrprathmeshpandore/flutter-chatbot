# MindVault AI — Backend Environment Configuration Example
# Copy this file to .env and customize values for your local environment:
#   cp .env.example .env

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/mindvault_db

# Alternative for lightweight local development / SQLite:
# DATABASE_URL=sqlite:///./mindvault.db

# JWT & Security Configuration
# Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change_this_to_a_long_random_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google Gemini API Configuration
# Obtain your API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Configurable model ID (verified working: gemini-3.5-flash, gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash
# Optional fallback model if primary model experiences high demand or timeouts
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Request timeout in seconds for Gemini API calls
GEMINI_TIMEOUT_SECONDS=12.0
# Transient error retry settings (bounded retry with exponential backoff & jitter)
GEMINI_MAX_RETRIES=2
GEMINI_INITIAL_RETRY_DELAY=1.0
GEMINI_MAX_RETRY_DELAY=4.0

# File Upload Settings
MAX_FILE_SIZE_MB=15

# CORS Configuration for Flutter
# Use "*" for development or comma-separated origins, e.g. "http://localhost:3000,http://127.0.0.1:8000"
CORS_ORIGINS=*
